# pass1 for data from STM modules

process_name : STMPass1

source : {
   module_type : RootInput
   fileNames   : @nil
   maxEvents   : -1
}

physics : {
   producers : {
      makeSTMDigis : {
         module_type                     : STMDigisFromFragments
         stmTag                          : "daq:ContainerSTM"
         verbosityLevel                  : 1
         saveSTMFragSummary              : true
         saveRawWaveformsWithHeaderHPGe  : false
         saveRawWaveformsHPGe            : true
         saveZSWaveformsHPGe             : true
         saveRawWaveformsWithHeaderLaBr  : false
         saveRawWaveformsLaBr            : true
         saveZSWaveformsLaBr             : true
        }
   }

   analyzers  : {
      dqmStm : {
         module_type         : DqmStm
         phHPGeTag           : "makeSTMDigis:phHPGe"
         phLaBrTag           : "makeSTMDigis:phLaBr"
         rawHPGeTag          : "makeSTMDigis:rawHPGe"
         rawLaBrTag          : "makeSTMDigis:rawLaBr"
         zsHPGeTag           : "makeSTMDigis:zsHPGe"
         zsLaBrTag           : "makeSTMDigis:zsLaBr"
         HPGefragSummaryTag  : "makeSTMDigis:stmFragSummaryHPGe"
         LaBrfragSummaryTag  : "makeSTMDigis:stmFragSummaryLaBr"
      }

      phTreeHPGe : {
         module_type  :  STMPHDigiTree
         phDigiTag    :  "makeSTMDigis:phHPGe"
      }

      phTreeLaBr : {
         module_type  :  STMPHDigiTree
	 phDigiTag    :  "mkaeSTMDigis:phLaBr"
      }

   }

   t1 : [ makeSTMDigis ]
   e1 : [ dqmStmOutput, stmOutput ]
   e2 : [phTreeHPGe, phTreeLaBr ]
   #e1 : [ ]
   #e1 : [ frag, stmOutput ]

   trigger_paths  : [t1]
   end_paths      : [e1, e2]

}

outputs : {
   stmOutput : {
      module_type    : RootOutput
      fileName       : "dig.stm.art"
      outputCommands : [ "keep *_*_*_*", "drop artdaq::*_*_*_*" ]
   }
}

services.TFileSerice.fileName : "stm_DQM.root"
# print summaries
services.DbService.verbose : true
services.scheduler.wantSummary : true
services.TimeTracker.printSummary : true
services.message.destinations.log.outputStatistics : true
